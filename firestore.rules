rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection: user profile, addresses & favorite caterers
    match /users/{userId} {
      allow read, write: if true;
    }

    // Kitchen configuration: store operational status & config
    match /kitchen_config/{docId} {
      allow read, write: if true;
    }

    // Weekly settlements: kitchen partner & admin settlement ledger
    match /weekly_settlements/{settlementId} {
      allow read, write: if true;
    }

    // Catering Orders: customers, kitchens & delivery staff
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
