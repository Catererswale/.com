<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".CaterersApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.aistudio.catererswale.customer"
            android:label="@string/app_name_customer"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Web App Links (Auto-verified HTTP/HTTPS for catererswale.com and catererswale.in) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="catererswale.com" android:pathPrefix="/menu" />
                <data android:scheme="https" android:host="catererswale.com" android:pathPrefix="/store" />
                <data android:scheme="https" android:host="catererswale.com" android:pathPrefix="/order" />
                <data android:scheme="https" android:host="www.catererswale.com" android:pathPrefix="/menu" />
                <data android:scheme="https" android:host="www.catererswale.com" android:pathPrefix="/store" />
                <data android:scheme="https" android:host="catererswale.in" android:pathPrefix="/menu" />
                <data android:scheme="https" android:host="catererswale.in" android:pathPrefix="/store" />
                <data android:scheme="https" android:host="catererswale.app" android:pathPrefix="/menu" />
                <data
                    android:scheme="https"
                    android:host="ais-pre-eqwyvpqmaxgfrpul7qeb65-24933968568.asia-southeast1.run.app"
                    android:pathPrefix="/menu" />
            </intent-filter>

            <!-- Custom URI Scheme (In-app deep links) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="catererswale"
                    android:host="menu" />
            </intent-filter>
        </activity>

        <!-- Dedicated Independent Activity for Kitchen Partner App (Direct access to Kitchen Dashboard) -->
        <activity
            android:name=".KitchenAppLauncher"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.aistudio.catererswale.kitchen"
            android:label="@string/app_name_kitchen"
            android:icon="@mipmap/ic_launcher_kitchen"
            android:roundIcon="@mipmap/ic_launcher_kitchen_round"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dedicated Independent Activity for Delivery Boy App (Direct access to Delivery Partner portal) -->
        <activity
            android:name=".DeliveryAppLauncher"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.aistudio.catererswale.delivery"
            android:label="@string/app_name_delivery"
            android:icon="@mipmap/ic_launcher_delivery"
            android:roundIcon="@mipmap/ic_launcher_delivery_round"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dedicated Independent Activity for Super Admin App (Direct access to Admin console) -->
        <activity
            android:name=".AdminAppLauncher"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.aistudio.catererswale.admin"
            android:label="@string/app_name_admin"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging Service -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <service
            android:name=".util.CaterersFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
